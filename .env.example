# EmailJS Configuration
# Sign up at https://www.emailjs.com/ and create:
# 1. An Email Service (e.g. Gmail) → copy Service ID
# 2. An Email Template with variables: {{from_name}}, {{from_email}}, {{message}}
#    Set "To Email" to your email address in the template
# 3. API Keys → copy Public Key from Account > API Keys
#
# Copy this file to .env and replace the placeholders below with your actual credentials.
# NEVER commit your .env file to git!

REACT_APP_EMAILJS_SERVICE_ID=your_service_id
REACT_APP_EMAILJS_TEMPLATE_ID=your_template_id
REACT_APP_EMAILJS_PUBLIC_KEY=your_public_key
